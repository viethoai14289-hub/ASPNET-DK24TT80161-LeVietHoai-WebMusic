@model IEnumerable<Playlist>
@{ ViewData["Title"] = "Quản lý playlist"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Playlist</h1>
    <a class="btn btn-success" asp-action="Create">+ Thêm playlist</a>
</div>
<div class="table-responsive">
    <table class="table table-striped table-hover table-bordered align-middle">
        <thead class="table-dark">
            <tr><th>Mã</th><th>Ảnh</th><th>Tên playlist</th><th>Người tạo</th><th>Thể loại</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var pl in Model)
            {
                <tr>
                    <td>@pl.MaPlayList</td>
                    <td><img src="~/images/playlist/@pl.HinhAnh" alt="" class="rounded wm-cover-xs" /></td>
                    <td>@pl.TenPlayList</td>
                    <td>@pl.NguoiTao</td>
                    <td>@pl.MaTheLoai</td>
                    <td>
                        <div class="d-flex gap-2 align-items-center">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@pl.MaPlayList">Sửa</a>
                            <form asp-action="Delete" asp-route-id="@pl.MaPlayList" method="post" onsubmit="return confirm('Xóa playlist này?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>