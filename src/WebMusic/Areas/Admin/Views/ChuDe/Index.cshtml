@model IEnumerable<ChuDe>
@{ ViewData["Title"] = "Quản lý chủ đề"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Chủ đề</h1>
    <a class="btn btn-success" asp-action="Create">+ Thêm chủ đề</a>
</div>
<div class="table-responsive">
    <table class="table table-striped table-hover table-bordered align-middle">
        <thead class="table-dark">
            <tr><th>Mã</th><th>Ảnh</th><th>Tên chủ đề</th><th>Mô tả</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var cd in Model)
            {
                <tr>
                    <td>@cd.MaChuDe</td>
                    <td><img src="~/images/chude/@cd.HinhAnh" alt="" class="rounded wm-cover-xs" /></td>
                    <td>@cd.TenChuDe</td>
                    <td class="d-block text-truncate wm-td-truncate">@(cd.MoTaThem ?? "")</td>
                    <td>
                        <div class="d-flex gap-2 align-items-center">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@cd.MaChuDe">Sửa</a>
                            <form asp-action="Delete" asp-route-id="@cd.MaChuDe" method="post" onsubmit="return confirm('Xóa chủ đề này?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>