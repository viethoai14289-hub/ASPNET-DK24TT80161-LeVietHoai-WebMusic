@model IEnumerable<ChuDe>
@{ ViewData["Title"] = "Quản lý chủ đề"; }
<div class="admin-toolbar">
    <h1>Chủ đề</h1>
    <a class="btn-primary" asp-action="Create">+ Thêm chủ đề</a>
</div>
<table class="admin-table">
    <thead><tr><th>Mã</th><th>Ảnh</th><th>Tên chủ đề</th><th>Mô tả</th><th></th></tr></thead>
    <tbody>
        @foreach (var cd in Model)
        {
            <tr>
                <td>@cd.MaChuDe</td>
                <td><img src="~/images/chude/@cd.HinhAnh" alt="" class="thumb" /></td>
                <td>@cd.TenChuDe</td>
                <td class="cell-truncate">@(cd.MoTaThem ?? "")</td>
                <td class="row-actions">
                    <a asp-action="Edit" asp-route-id="@cd.MaChuDe">Sửa</a>
                    <form asp-action="Delete" asp-route-id="@cd.MaChuDe" method="post" onsubmit="return confirm('Xóa chủ đề này?')">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-danger">Xóa</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>