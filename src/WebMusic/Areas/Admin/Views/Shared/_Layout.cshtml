<!DOCTYPE html>
<html lang="vi" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin WebMusic</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        .admin-sidebar {
            width: 240px;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            z-index: 1030;
            overflow-y: auto;
        }
        .admin-sidebar .nav-link {
            color: rgba(255,255,255,.8);
            border-radius: .375rem;
            padding: .5rem .75rem;
        }
        .admin-sidebar .nav-link:hover,
        .admin-sidebar .nav-link.active {
            color: #fff;
            background: rgba(29,185,84,.25);
        }
        @@media (min-width: 992px) {
            .admin-content { margin-left: 240px; }
        }
    </style>
</head>
<body class="bg-body-tertiary">
    <!-- Sidebar desktop: cố định trái, chỉ hiện ≥992px -->
    <aside class="admin-sidebar bg-dark text-white p-3 d-none d-lg-flex flex-column">
        <div class="d-flex flex-column h-100">
            @await Html.PartialAsync("_SidebarNav")
        </div>
    </aside>

    <!-- Sidebar mobile/tablet: offcanvas, chỉ hiện <992px -->
    <div class="offcanvas offcanvas-start bg-dark text-white" id="adminSidebar" tabindex="-1">
        <div class="offcanvas-header border-bottom border-secondary">
            <h5 class="offcanvas-title">Menu</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Đóng"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column">
            @await Html.PartialAsync("_SidebarNav")
        </div>
    </div>

    <!-- Content -->
    <div class="admin-content min-vh-100 d-flex flex-column">
        <!-- Header mobile/tablet: hamburger -->
        <header class="bg-dark text-white sticky-top d-lg-none">
            <div class="d-flex align-items-center p-2">
                <button class="btn btn-dark me-2 border-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar" aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <span class="fw-bold">Admin WebMusic</span>
            </div>
        </header>

        <main class="container-fluid py-4 px-3 px-lg-4 flex-grow-1">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>