<!DOCTYPE html>
<html lang="vi" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin NCT</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="bg-body-tertiary">
    <!-- Sidebar desktop: cố định trái, chỉ hiện ≥992px -->
    <aside class="admin-sidebar bg-dark text-white p-3 d-none d-lg-flex flex-column">
        <div class="d-flex flex-column h-100">
            @await Html.PartialAsync("_SidebarNav")
        </div>
    </aside>

    <!-- Sidebar mobile/tablet: offcanvas, chỉ hiện <992px -->
    <div class="offcanvas offcanvas-start bg-dark text-white" id="adminSidebar" tabindex="-1">
        <div class="offcanvas-header border-bottom border-secondary">
            <h5 class="offcanvas-title">Menu</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Đóng"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column">
            @await Html.PartialAsync("_SidebarNav")
        </div>
    </div>

    <div class="admin-content min-vh-100 d-flex flex-column">
        <header class="bg-dark text-white sticky-top d-lg-none">
            <div class="d-flex align-items-center p-2">
                <button class="btn btn-dark me-2 border-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar" aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <span class="fw-bold">Quản trị NCT</span>
            </div>
        </header>

        <main class="container-fluid py-4 px-3 px-lg-4 flex-grow-1">
            @RenderBody()
        </main>

        <footer class="border-top bg-white py-3 mt-auto">
            <div class="container-fluid px-3 px-lg-4">
                <p class="text-muted small mb-0 text-center text-lg-start">
                    © 2026 NCT — Hệ thống quản trị. Đồ án chuyên đề ASP.NET Core 8 MVC | ĐH Trà Vinh — DK24TT80161.
                </p>
            </div>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>