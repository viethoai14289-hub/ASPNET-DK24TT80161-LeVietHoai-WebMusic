<!DOCTYPE html>
<html lang="vi" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin WebMusic</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-body-tertiary min-vh-100 d-flex flex-column">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
        <div class="container-fluid">
            <span class="navbar-brand fw-bold">Giao diện ADMIN</span>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNav" aria-controls="adminNav" aria-expanded="false" aria-label="Mở menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="adminNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link" asp-controller="CaSi" asp-action="Index">Ca sĩ</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="TheLoai" asp-action="Index">Thể loại</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="ChuDe" asp-action="Index">Chủ đề</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Playlist" asp-action="Index">Playlist</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="BaiHat" asp-action="Index">Bài hát</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Album" asp-action="Index">Album</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="CaSiBaiHat" asp-action="Index">Ca sĩ-Bài hát</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="CaSiAlbum" asp-action="Index">Ca sĩ-Album</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="PlaylistBaiHat" asp-action="Index">Playlist-Bài hát</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="TaiKhoan" asp-action="Index">Tài khoản</a></li>
                </ul>
                <a class="btn btn-danger btn-sm" asp-controller="Account" asp-action="Logout">Đăng xuất</a>
            </div>
        </div>
    </nav>

    <main class="container-fluid py-4 flex-grow-1">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>