@model IEnumerable<BaiHat>
@{
    ViewData["Title"] = "Quản lý bài hát";
}

<div class="admin-toolbar">
    <h1>Bài hát</h1>
    <a class="btn-primary" asp-action="Create">+ Thêm bài hát</a>
</div>

<table class="admin-table">
    <thead>
        <tr><th>Mã</th><th>Ảnh</th><th>Tên</th><th>Tác giả</th><th>Thể loại</th><th>Album</th><th>Chủ đề</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var bh in Model)
        {
            <tr>
                <td>@bh.MaBaiHat</td>
                <td><img src="~/images/baihat/@bh.HinhAnh" alt="" class="thumb" /></td>
                <td>@bh.TenBaiHat</td>
                <td>@bh.TacGia</td>
                <td>@bh.MaTheLoai</td>
                <td>@bh.MaAlbum</td>
                <td>@bh.MaChuDe</td>
                <td class="row-actions">
                    <a asp-action="Edit" asp-route-id="@bh.MaBaiHat">Sửa</a>
                    <form asp-action="Delete" asp-route-id="@bh.MaBaiHat" method="post"
                          onsubmit="return confirm('Xóa bài hát này?')">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-danger">Xóa</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>