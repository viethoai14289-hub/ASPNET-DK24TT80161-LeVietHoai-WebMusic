@model IEnumerable<BaiHat>
@{
    ViewData["Title"] = "Quản lý bài hát";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Bài hát</h1>
    <a class="btn btn-success" asp-action="Create">+ Thêm bài hát</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover table-bordered align-middle">
        <thead class="table-dark">
            <tr><th>Mã</th><th>Ảnh</th><th>Tên</th><th>Tác giả</th><th>Thể loại</th><th>Album</th><th>Chủ đề</th><th>Thời lượng</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var bh in Model)
            {
                var mm = bh.Duration / 60; var ss = bh.Duration % 60;
                <tr>
                    <td>@bh.MaBaiHat</td>
                    <td><img src="~/images/baihat/@bh.HinhAnh" alt="" class="rounded wm-cover-xs" /></td>
                    <td>@bh.TenBaiHat</td>
                    <td>@bh.TacGia</td>
                    <td>@bh.MaTheLoai</td>
                    <td>@bh.MaAlbum</td>
                    <td>@bh.MaChuDe</td>
                    <td>@($"{mm}:{ss:D2}")</td>
                    <td>
                        <div class="d-flex gap-2 align-items-center">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@bh.MaBaiHat">Sửa</a>
                            <form asp-action="Delete" asp-route-id="@bh.MaBaiHat" method="post" onsubmit="return confirm('Xóa bài hát này?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>