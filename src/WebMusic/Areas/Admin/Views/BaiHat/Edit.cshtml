@model BaiHat
@{
    ViewData["Title"] = "Sửa bài hát";
    var tls = ViewBag.TheLoais as List<TheLoai> ?? new();
    var abs = ViewBag.Albums as List<Album> ?? new();
    var cds = ViewBag.ChuDes as List<ChuDe> ?? new();
}

<h1 class="h3 mb-3">Sửa bài hát</h1>
@if (!string.IsNullOrEmpty(Model.HinhAnh))
{
    <img src="~/images/baihat/@Model.HinhAnh" alt="" class="rounded mb-3 wm-cover-md" />
}
<div class="card wm-card-form">
    <div class="card-body">
        <form method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="MaBaiHat" />
            <div class="mb-3">
                <label class="form-label">Tên bài hát</label>
                <input asp-for="TenBaiHat" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Tác giả</label>
                <input asp-for="TacGia" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Ảnh mới (để trống nếu giữ nguyên)</label>
                <input type="file" name="anh" accept="image/*" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Link bài hát (tên file mp3)</label>
                <input asp-for="LinkBaiHat" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Thời lượng (giây)</label>
                <input asp-for="Duration" type="number" min="0" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Thể loại</label>
                <select asp-for="MaTheLoai" class="form-select">
                    @foreach (var t in tls) { <option value="@t.MaTheLoai" selected="@(t.MaTheLoai == Model.MaTheLoai)">@t.TenTheLoai</option> }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Album</label>
                <select asp-for="MaAlbum" class="form-select">
                    @foreach (var a in abs) { <option value="@a.MaAlbum" selected="@(a.MaAlbum == Model.MaAlbum)">@a.TenAlbum</option> }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Chủ đề</label>
                <select asp-for="MaChuDe" class="form-select">
                    @foreach (var c in cds) { <option value="@c.MaChuDe" selected="@(c.MaChuDe == Model.MaChuDe)">@c.TenChuDe</option> }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Lời bài hát</label>
                <textarea asp-for="LoiBaiHat" rows="5" class="form-control"></textarea>
            </div>
            <button type="submit" class="btn btn-success">Cập nhật</button>
            <a asp-action="Index" class="btn btn-link">Hủy</a>
        </form>
    </div>
</div>