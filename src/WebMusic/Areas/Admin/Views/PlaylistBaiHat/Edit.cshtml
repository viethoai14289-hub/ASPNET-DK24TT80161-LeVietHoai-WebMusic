@model PlaylistBaiHat
@{
    ViewData["Title"] = "Sửa Playlist - Bài hát";
    var pl = ViewBag.Playlists as List<Playlist> ?? new();
    var bh = ViewBag.BaiHats as List<BaiHat> ?? new();
}
<h1 class="h3 mb-3">Sửa Playlist - Bài hát</h1>
<div class="card wm-card-form">
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="mb-3">
                <label class="form-label">Playlist</label>
                <select asp-for="MaPlayList" class="form-select">
                    @foreach (var p in pl) { <option value="@p.MaPlayList" selected="@(p.MaPlayList == Model.MaPlayList)">@p.TenPlayList</option> }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Bài hát</label>
                <select asp-for="MaBaiHat" class="form-select">
                    @foreach (var b in bh) { <option value="@b.MaBaiHat" selected="@(b.MaBaiHat == Model.MaBaiHat)">@b.TenBaiHat</option> }
                </select>
            </div>
            <button type="submit" class="btn btn-success">Cập nhật</button>
            <a asp-action="Index" class="btn btn-link">Hủy</a>
        </form>
    </div>
</div>