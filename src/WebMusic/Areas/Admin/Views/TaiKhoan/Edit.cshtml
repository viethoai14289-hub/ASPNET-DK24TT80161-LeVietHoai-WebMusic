@model TaiKhoan
@{ ViewData["Title"] = "Sửa tài khoản"; }
<h1 class="h3 mb-3">Sửa tài khoản</h1>
<div class="card wm-card-form">
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="mb-3">
                <label class="form-label">Tên đăng nhập</label>
                <input asp-for="TenDangNhap" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Mật khẩu mới (để trống nếu không đổi)</label>
                <input type="password" name="newMatKhau" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Vai trò</label>
                <select asp-for="VaiTro" class="form-select">
                    <option value="User">User</option>
                    <option value="Admin">Admin</option>
                </select>
            </div>
            <button type="submit" class="btn btn-success">Cập nhật</button>
            <a asp-action="Index" class="btn btn-link">Hủy</a>
        </form>
    </div>
</div>