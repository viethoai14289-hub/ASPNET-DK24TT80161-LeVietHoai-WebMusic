@model IEnumerable<TaiKhoan>
@{ ViewData["Title"] = "Quản lý tài khoản"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Tài khoản</h1>
    <a class="btn btn-success" asp-action="Create">+ Thêm tài khoản</a>
</div>
<div class="table-responsive">
    <table class="table table-striped table-hover table-bordered align-middle">
        <thead class="table-dark">
            <tr><th>ID</th><th>Tên đăng nhập</th><th>Vai trò</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var tk in Model)
            {
                <tr>
                    <td>@tk.Id</td>
                    <td>@tk.TenDangNhap</td>
                    <td><span class="badge @(tk.VaiTro == "Admin" ? "text-bg-success" : "text-bg-secondary")">@tk.VaiTro</span></td>
                    <td>
                        <div class="d-flex gap-2 align-items-center">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@tk.Id">Sửa</a>
                            <form asp-action="Delete" asp-route-id="@tk.Id" method="post" onsubmit="return confirm('Xóa tài khoản này?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>