@model IEnumerable<TaiKhoan>
@{ ViewData["Title"] = "Quản lý tài khoản"; }
<div class="admin-toolbar">
    <h1>Tài khoản</h1>
    <a class="btn-primary" asp-action="Create">+ Thêm tài khoản</a>
</div>
<table class="admin-table">
    <thead><tr><th>ID</th><th>Tên đăng nhập</th><th></th></tr></thead>
    <tbody>
        @foreach (var tk in Model)
        {
            <tr>
                <td>@tk.Id</td>
                <td>@tk.TenDangNhap</td>
                <td class="row-actions">
                    <a asp-action="Edit" asp-route-id="@tk.Id">Sửa</a>
                    <form asp-action="Delete" asp-route-id="@tk.Id" method="post" onsubmit="return confirm('Xóa tài khoản này?')">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-danger">Xóa</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>