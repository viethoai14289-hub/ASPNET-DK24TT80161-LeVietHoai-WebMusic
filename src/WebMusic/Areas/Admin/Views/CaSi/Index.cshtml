@model IEnumerable<CaSi>
@{
    ViewData["Title"] = "Quản lý ca sĩ";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Ca sĩ</h1>
    <a class="btn btn-success" asp-action="Create">+ Thêm ca sĩ</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover table-bordered align-middle">
        <thead class="table-dark">
            <tr><th>Mã</th><th>Ảnh</th><th>Tên</th><th>Năm sinh</th><th>Quê quán</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var cs in Model)
            {
                <tr>
                    <td>@cs.MaCaSi</td>
                    <td><img src="~/images/casi/@cs.HinhAnh" alt="" class="rounded wm-cover-xs" /></td>
                    <td>@cs.TenCaSi</td>
                    <td>@cs.NamSinh</td>
                    <td>@cs.QueQuan</td>
                    <td>
                        <div class="d-flex gap-2 align-items-center">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@cs.MaCaSi">Sửa</a>
                            <form asp-action="Delete" asp-route-id="@cs.MaCaSi" method="post" onsubmit="return confirm('Xóa ca sĩ này?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>