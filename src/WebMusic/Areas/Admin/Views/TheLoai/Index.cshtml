@model IEnumerable<TheLoai>
@{ ViewData["Title"] = "Quản lý thể loại"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Thể loại</h1>
    <a class="btn btn-success" asp-action="Create">+ Thêm thể loại</a>
</div>
<div class="table-responsive">
    <table class="table table-striped table-hover table-bordered align-middle">
        <thead class="table-dark">
            <tr><th>Mã</th><th>Ảnh</th><th>Tên thể loại</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var tl in Model)
            {
                <tr>
                    <td>@tl.MaTheLoai</td>
                    <td><img src="~/images/theloai/@tl.HinhAnh" alt="" class="rounded wm-cover-xs" /></td>
                    <td>@tl.TenTheLoai</td>
                    <td>
                        <div class="d-flex gap-2 align-items-center">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@tl.MaTheLoai">Sửa</a>
                            <form asp-action="Delete" asp-route-id="@tl.MaTheLoai" method="post" onsubmit="return confirm('Xóa thể loại này?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>