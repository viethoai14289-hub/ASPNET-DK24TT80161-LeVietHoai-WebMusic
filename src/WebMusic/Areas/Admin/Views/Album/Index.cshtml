@model IEnumerable<Album>
@{ ViewData["Title"] = "Quản lý album"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Album</h1>
    <a class="btn btn-success" asp-action="Create">+ Thêm album</a>
</div>
<div class="table-responsive">
    <table class="table table-striped table-hover table-bordered align-middle">
        <thead class="table-dark">
            <tr><th>Mã</th><th>Ảnh</th><th>Tên album</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var ab in Model)
            {
                <tr>
                    <td>@ab.MaAlbum</td>
                    <td><img src="~/images/album/@ab.HinhAnh" alt="" class="rounded wm-cover-xs" /></td>
                    <td>@ab.TenAlbum</td>
                    <td>
                        <div class="d-flex gap-2 align-items-center">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@ab.MaAlbum">Sửa</a>
                            <form asp-action="Delete" asp-route-id="@ab.MaAlbum" method="post" onsubmit="return confirm('Xóa album này?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>