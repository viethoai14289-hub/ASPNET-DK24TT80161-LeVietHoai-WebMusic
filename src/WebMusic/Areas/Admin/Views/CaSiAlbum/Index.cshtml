@model IEnumerable<CaSiAlbum>
@{ ViewData["Title"] = "Ca sĩ - Album"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Ca sĩ - Album</h1>
    <a class="btn btn-success" asp-action="Create">+ Thêm liên kết</a>
</div>
<div class="table-responsive">
    <table class="table table-striped table-hover table-bordered align-middle">
        <thead class="table-dark"><tr><th>ID</th><th>Ca sĩ</th><th>Album</th><th></th></tr></thead>
        <tbody>
            @foreach (var x in Model)
            {
                <tr>
                    <td>@x.Id</td><td>@x.MaCaSi</td><td>@x.MaAlbum</td>
                    <td>
                        <div class="d-flex gap-2 align-items-center">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@x.Id">Sửa</a>
                            <form asp-action="Delete" asp-route-id="@x.Id" method="post" onsubmit="return confirm('Xóa?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>