@model CaSiAlbum
@{
    ViewData["Title"] = "Thêm Ca sĩ - Album";
    var cs = ViewBag.CaSis as List<CaSi> ?? new();
    var ab = ViewBag.Albums as List<Album> ?? new();
}
<h1>Thêm Ca sĩ - Album</h1>
<form method="post" class="admin-form">
    @Html.AntiForgeryToken()
    <label>Ca sĩ
        <select name="maCaSi">
            @foreach (var c in cs) { <option value="@c.MaCaSi">@c.TenCaSi</option> }
        </select>
    </label>
    <label>Album
        <select name="maAlbum">
            @foreach (var a in ab) { <option value="@a.MaAlbum">@a.TenAlbum</option> }
        </select>
    </label>
    <button type="submit" class="btn-primary">Lưu</button>
    <a asp-action="Index" class="btn-link">Hủy</a>
</form>