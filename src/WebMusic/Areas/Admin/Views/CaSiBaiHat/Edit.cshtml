@model CaSiBaiHat
@{
    ViewData["Title"] = "Sửa Ca sĩ - Bài hát";
    var cs = ViewBag.CaSis as List<CaSi> ?? new();
    var bh = ViewBag.BaiHats as List<BaiHat> ?? new();
}
<h1 class="h3 mb-3">Sửa Ca sĩ - Bài hát</h1>
<div class="card wm-card-form">
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="mb-3">
                <label class="form-label">Ca sĩ</label>
                <select asp-for="MaCaSi" class="form-select">
                    @foreach (var c in cs) { <option value="@c.MaCaSi" selected="@(c.MaCaSi == Model.MaCaSi)">@c.TenCaSi</option> }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Bài hát</label>
                <select asp-for="MaBaiHat" class="form-select">
                    @foreach (var b in bh) { <option value="@b.MaBaiHat" selected="@(b.MaBaiHat == Model.MaBaiHat)">@b.TenBaiHat</option> }
                </select>
            </div>
            <button type="submit" class="btn btn-success">Cập nhật</button>
            <a asp-action="Index" class="btn btn-link">Hủy</a>
        </form>
    </div>
</div>