@model CaSiBaiHat
@{
    ViewData["Title"] = "Sửa Ca sĩ - Bài hát";
    var cs = ViewBag.CaSis as List<CaSi> ?? new();
    var bh = ViewBag.BaiHats as List<BaiHat> ?? new();
}
<h1>Sửa Ca sĩ - Bài hát</h1>
<form method="post" class="admin-form">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <label>Ca sĩ
        <select asp-for="MaCaSi">
            @foreach (var c in cs) { <option value="@c.MaCaSi" selected="@(c.MaCaSi == Model.MaCaSi)">@c.TenCaSi</option> }
        </select>
    </label>
    <label>Bài hát
        <select asp-for="MaBaiHat">
            @foreach (var b in bh) { <option value="@b.MaBaiHat" selected="@(b.MaBaiHat == Model.MaBaiHat)">@b.TenBaiHat</option> }
        </select>
    </label>
    <button type="submit" class="btn-primary">Cập nhật</button>
    <a asp-action="Index" class="btn-link">Hủy</a>
</form>