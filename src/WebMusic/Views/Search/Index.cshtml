@model SearchVM
@{
    ViewData["Title"] = "Tìm kiếm";
}

<h1>Kết quả tìm kiếm: "@Model.Query"</h1>

@if (string.IsNullOrWhiteSpace(Model.Query))
{
    <p class="muted">Nhập từ khóa vào ô tìm kiếm.</p>
    return;
}

@if (Model.BaiHats.Any())
{
    <section class="section">
        <h2>Bài hát</h2>
        <div class="card-grid">
            @foreach (var bh in Model.BaiHats)
            {
                <a class="card" asp-controller="BaiHat" asp-action="Detail" asp-route-id="@bh.MaBaiHat">
                    <img src="~/images/baihat/@bh.HinhAnh" alt="@bh.TenBaiHat" />
                    <span>@bh.TenBaiHat</span>
                    <small>@bh.TacGia</small>
                </a>
            }
        </div>
    </section>
}

@if (Model.CaSis.Any())
{
    <section class="section">
        <h2>Ca sĩ</h2>
        <div class="card-grid">
            @foreach (var cs in Model.CaSis)
            {
                <a class="card" asp-controller="CaSi" asp-action="Detail" asp-route-id="@cs.MaCaSi">
                    <img src="~/images/casi/@cs.HinhAnh" alt="@cs.TenCaSi" />
                    <span>@cs.TenCaSi</span>
                </a>
            }
        </div>
    </section>
}

@if (Model.Albums.Any())
{
    <section class="section">
        <h2>Album</h2>
        <div class="card-grid">
            @foreach (var ab in Model.Albums)
            {
                <a class="card" asp-controller="Album" asp-action="Detail" asp-route-id="@ab.MaAlbum">
                    <img src="~/images/album/@ab.HinhAnh" alt="@ab.TenAlbum" />
                    <span>@ab.TenAlbum</span>
                </a>
            }
        </div>
    </section>
}

@if (Model.Playlists.Any())
{
    <section class="section">
        <h2>Playlist</h2>
        <div class="card-grid">
            @foreach (var pl in Model.Playlists)
            {
                <a class="card" asp-controller="Playlist" asp-action="Detail" asp-route-id="@pl.MaPlayList">
                    <img src="~/images/playlist/@pl.HinhAnh" alt="@pl.TenPlayList" />
                    <span>@pl.TenPlayList</span>
                </a>
            }
        </div>
    </section>
}

@if (Model.TheLoais.Any())
{
    <section class="section">
        <h2>Thể loại</h2>
        <div class="card-grid">
            @foreach (var tl in Model.TheLoais)
            {
                <a class="card" asp-controller="TheLoai" asp-action="Index" asp-route-id="@tl.MaTheLoai">
                    <img src="~/images/theloai/@tl.HinhAnh" alt="@tl.TenTheLoai" />
                    <span>@tl.TenTheLoai</span>
                </a>
            }
        </div>
    </section>
}

@if (Model.ChuDes.Any())
{
    <section class="section">
        <h2>Chủ đề</h2>
        <div class="card-grid">
            @foreach (var cd in Model.ChuDes)
            {
                <a class="card" asp-controller="ChuDe" asp-action="Detail" asp-route-id="@cd.MaChuDe">
                    <img src="~/images/chude/@cd.HinhAnh" alt="@cd.TenChuDe" />
                    <span>@cd.TenChuDe</span>
                </a>
            }
        </div>
    </section>
}

@if (!Model.BaiHats.Any() && !Model.CaSis.Any() && !Model.Albums.Any()
   && !Model.Playlists.Any() && !Model.TheLoais.Any() && !Model.ChuDes.Any())
{
    <p class="muted">Không tìm thấy kết quả nào.</p>
}