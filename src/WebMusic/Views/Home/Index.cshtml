@model TrangChuVM
@{
    ViewData["Title"] = "Trang chủ";
}

<!-- Slideshow -->
<div id="heroCarousel" class="carousel slide mb-4 rounded overflow-hidden" data-bs-ride="carousel">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active" aria-label="Slide 1"></button>
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
    </div>
    <div class="carousel-inner">
        <div class="carousel-item active ratio ratio-21x9">
            <img src="~/images/slideshow/pic1.jpg" class="object-fit-cover" alt="slide 1" />
        </div>
        <div class="carousel-item ratio ratio-21x9">
            <img src="~/images/slideshow/pic2.jpg" class="object-fit-cover" alt="slide 2" />
        </div>
        <div class="carousel-item ratio ratio-21x9">
            <img src="~/images/slideshow/pic3.jpg" class="object-fit-cover" alt="slide 3" />
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev" aria-label="Slide trước">
        <span class="carousel-control-prev-icon"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next" aria-label="Slide sau">
        <span class="carousel-control-next-icon"></span>
    </button>
</div>

<section class="mb-4">
    <h2 class="h4 mb-3 border-start border-success ps-2">Thể loại</h2>
    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-3">
        @foreach (var tl in Model.TheLoais)
        {
            <div class="col">
                <a class="card h-100 text-decoration-none text-body" asp-controller="TheLoai" asp-action="Index" asp-route-id="@tl.MaTheLoai">
                    <img src="~/images/theloai/@tl.HinhAnh" class="card-img-top ratio ratio-1x1 object-fit-cover" alt="@tl.TenTheLoai" />
                    <div class="card-body p-2"><span class="fw-semibold small">@tl.TenTheLoai</span></div>
                </a>
            </div>
        }
    </div>
</section>

<section class="mb-4">
    <h2 class="h4 mb-3 border-start border-success ps-2">Chủ đề</h2>
    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-3">
        @foreach (var cd in Model.ChuDes)
        {
            <div class="col">
                <a class="card h-100 text-decoration-none text-body" asp-controller="ChuDe" asp-action="Detail" asp-route-id="@cd.MaChuDe">
                    <img src="~/images/chude/@cd.HinhAnh" class="card-img-top ratio ratio-1x1 object-fit-cover" alt="@cd.TenChuDe" />
                    <div class="card-body p-2"><span class="fw-semibold small">@cd.TenChuDe</span></div>
                </a>
            </div>
        }
    </div>
</section>

<section class="mb-4">
    <h2 class="h4 mb-3 border-start border-success ps-2">Album</h2>
    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-3">
        @foreach (var ab in Model.Albums)
        {
            <div class="col">
                <a class="card h-100 text-decoration-none text-body" asp-controller="Album" asp-action="Detail" asp-route-id="@ab.MaAlbum">
                    <img src="~/images/album/@ab.HinhAnh" class="card-img-top ratio ratio-1x1 object-fit-cover" alt="@ab.TenAlbum" />
                    <div class="card-body p-2"><span class="fw-semibold small">@ab.TenAlbum</span></div>
                </a>
            </div>
        }
    </div>
</section>

<section class="mb-4">
    <h2 class="h4 mb-3 border-start border-success ps-2">Bài hát</h2>
    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-3">
        @foreach (var bh in Model.BaiHats)
        {
            <div class="col">
                <a class="card h-100 text-decoration-none text-body" asp-controller="BaiHat" asp-action="Detail" asp-route-id="@bh.MaBaiHat">
                    <img src="~/images/baihat/@bh.HinhAnh" class="card-img-top ratio ratio-1x1 object-fit-cover" alt="@bh.TenBaiHat" />
                    <div class="card-body p-2">
                        <span class="fw-semibold small d-block text-truncate">@bh.TenBaiHat</span>
                        <small class="text-muted">@bh.TacGia</small>
                    </div>
                </a>
            </div>
        }
    </div>
</section>