@model TrangChuVM
@{
    ViewData["Title"] = "Trang chủ";
}

<!-- Slideshow -->
<div class="slideshow-container">
    <div class="mySlides fade"><img src="~/images/slideshow/pic1.jpg" alt="slide 1" /></div>
    <div class="mySlides fade"><img src="~/images/slideshow/pic2.jpg" alt="slide 2" /></div>
    <div class="mySlides fade"><img src="~/images/slideshow/pic3.jpg" alt="slide 3" /></div>
    <button class="prev" type="button" onclick="plusSlides(-1)" aria-label="Slide trước">&#10094;</button>
    <button class="next" type="button" onclick="plusSlides(1)" aria-label="Slide sau">&#10095;</button>
    <div class="dots">
        <button class="dot" type="button" onclick="currentSlide(1)" aria-label="Slide 1"></button>
        <button class="dot" type="button" onclick="currentSlide(2)" aria-label="Slide 2"></button>
        <button class="dot" type="button" onclick="currentSlide(3)" aria-label="Slide 3"></button>
    </div>
</div>

<section class="section">
    <h2>Thể loại</h2>
    <div class="card-grid">
        @foreach (var tl in Model.TheLoais)
        {
            <a class="card" asp-controller="TheLoai" asp-action="Index" asp-route-id="@tl.MaTheLoai">
                <img src="~/images/theloai/@tl.HinhAnh" alt="@tl.TenTheLoai" />
                <span>@tl.TenTheLoai</span>
            </a>
        }
    </div>
</section>

<section class="section">
    <h2>Chủ đề</h2>
    <div class="card-grid">
        @foreach (var cd in Model.ChuDes)
        {
            <a class="card" asp-controller="ChuDe" asp-action="Detail" asp-route-id="@cd.MaChuDe">
                <img src="~/images/chude/@cd.HinhAnh" alt="@cd.TenChuDe" />
                <span>@cd.TenChuDe</span>
            </a>
        }
    </div>
</section>

<section class="section">
    <h2>Album</h2>
    <div class="card-grid">
        @foreach (var ab in Model.Albums)
        {
            <a class="card" asp-controller="Album" asp-action="Detail" asp-route-id="@ab.MaAlbum">
                <img src="~/images/album/@ab.HinhAnh" alt="@ab.TenAlbum" />
                <span>@ab.TenAlbum</span>
            </a>
        }
    </div>
</section>

<section class="section">
    <h2>Bài hát</h2>
    <div class="card-grid">
        @foreach (var bh in Model.BaiHats)
        {
            <a class="card" asp-controller="BaiHat" asp-action="Detail" asp-route-id="@bh.MaBaiHat">
                <img src="~/images/baihat/@bh.HinhAnh" alt="@bh.TenBaiHat" />
                <span>@bh.TenBaiHat</span>
                <small>@bh.TacGia</small>
            </a>
        }
    </div>
</section>