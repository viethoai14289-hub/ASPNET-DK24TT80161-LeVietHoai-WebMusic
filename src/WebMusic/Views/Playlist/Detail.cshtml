@model Playlist
@{
    ViewData["Title"] = Model.TenPlayList;
    var baiHats = ViewBag.BaiHats as List<BaiHat> ?? new();
}

<div class="d-flex flex-wrap gap-4 mb-4">
    <img class="rounded" style="width:220px;height:220px;object-fit:cover" src="~/images/playlist/@Model.HinhAnh" alt="@Model.TenPlayList" />
    <div class="flex-grow-1" style="min-width:240px">
        <h1 class="h2">@Model.TenPlayList</h1>
        <p class="text-muted">Người tạo: @Model.NguoiTao</p>
    </div>
</div>

<section class="mb-4">
    <h2 class="h4 mb-3 border-start border-success ps-2">Bài hát trong playlist</h2>
    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-3">
        @foreach (var bh in baiHats)
        {
            <div class="col">
                <a class="card h-100 text-decoration-none text-body" asp-controller="BaiHat" asp-action="Detail" asp-route-id="@bh.MaBaiHat">
                    <img src="~/images/baihat/@bh.HinhAnh" class="card-img-top ratio ratio-1x1 object-fit-cover" alt="@bh.TenBaiHat" />
                    <div class="card-body p-2">
                        <span class="fw-semibold small d-block text-truncate">@bh.TenBaiHat</span>
                        <small class="text-muted">@bh.TacGia</small>
                    </div>
                </a>
            </div>
        }
    </div>
</section>