@{
    ViewData["Title"] = "Đăng nhập";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="card bg-body-tertiary mx-auto my-5" style="max-width:420px">
    <div class="card-body p-4">
        <h1 class="h3 mb-3">Đăng nhập</h1>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                { <p class="mb-0">@e.ErrorMessage</p> }
            </div>
        }

        <form method="post" asp-action="Login" asp-route-returnUrl="@returnUrl">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label">Tên đăng nhập</label>
                <input type="text" name="tenDangNhap" class="form-control" required autocomplete="username" />
            </div>
            <div class="mb-3">
                <label class="form-label">Mật khẩu</label>
                <input type="password" name="matkhau" class="form-control" required autocomplete="current-password" />
            </div>
            <button type="submit" class="btn btn-success">Đăng nhập</button>
        </form>
        <p class="mt-3 mb-0">Chưa có tài khoản? <a asp-action="Register">Đăng ký</a></p>
    </div>
</div>