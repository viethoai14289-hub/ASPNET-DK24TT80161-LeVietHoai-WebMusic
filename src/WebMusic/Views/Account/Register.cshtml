@{
    ViewData["Title"] = "Đăng ký";
}

<div class="auth-form">
    <h1>Đăng ký</h1>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert-error">
            @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            { <p>@e.ErrorMessage</p> }
        </div>
    }

    <form method="post" asp-action="Register">
        @Html.AntiForgeryToken()
        <label>Tên đăng nhập
            <input type="text" name="tenDangNhap" required autocomplete="username" />
        </label>
        <label>Mật khẩu (tối thiểu 5 ký tự)
            <input type="password" name="matKhau" required autocomplete="new-password" />
        </label>
        <label>Nhập lại mật khẩu
            <input type="password" name="rematkhau" required autocomplete="new-password" />
        </label>
        <button type="submit" class="btn-primary">Đăng ký</button>
    </form>
    <p>Đã có tài khoản? <a asp-action="Login">Đăng nhập</a></p>
</div>