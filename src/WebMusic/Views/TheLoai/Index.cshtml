@model TheLoaiVM
@{
    ViewData["Title"] = "Thể loại";
}

<section class="mb-4">
    <h2 class="h4 mb-3 border-start border-success ps-2">Thể loại</h2>
    <div class="row row-cols-2 row-cols-md-4 row-cols-lg-6 g-3">
        @foreach (var tl in Model.TheLoais)
        {
            <div class="col">
                <a class="card h-100 text-decoration-none text-body @(Model.SelectedId == tl.MaTheLoai ? "border border-success border-2" : "")"
                   asp-controller="TheLoai" asp-action="Index" asp-route-id="@tl.MaTheLoai">
                    <img src="~/images/theloai/@tl.HinhAnh" class="card-img-top ratio ratio-1x1 object-fit-cover" alt="@tl.TenTheLoai" />
                    <div class="card-body p-2"><span class="fw-semibold small">@tl.TenTheLoai</span></div>
                </a>
            </div>
        }
    </div>
</section>

@if (Model.Playlists.Any())
{
    <section class="mb-4">
        <h2 class="h4 mb-3 border-start border-success ps-2">Playlist theo thể loại</h2>
        <div class="row row-cols-2 row-cols-md-4 row-cols-lg-6 g-3">
            @foreach (var pl in Model.Playlists)
            {
                <div class="col">
                    <a class="card h-100 text-decoration-none text-body" asp-controller="Playlist" asp-action="Detail" asp-route-id="@pl.MaPlayList">
                        <img src="~/images/playlist/@pl.HinhAnh" class="card-img-top ratio ratio-1x1 object-fit-cover" alt="@pl.TenPlayList" />
                        <div class="card-body p-2">
                            <span class="fw-semibold small d-block text-truncate">@pl.TenPlayList</span>
                            <small class="text-muted">@pl.NguoiTao</small>
                        </div>
                    </a>
                </div>
            }
        </div>
    </section>
}