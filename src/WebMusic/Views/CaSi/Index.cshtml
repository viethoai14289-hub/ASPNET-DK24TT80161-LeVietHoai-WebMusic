@model IEnumerable<CaSi>
@{
    ViewData["Title"] = "Ca sĩ";
}

<section class="mb-4">
    <h2 class="h4 mb-3 border-start border-success ps-2">Ca sĩ</h2>
    <div class="row row-cols-2 row-cols-md-4 row-cols-lg-6 g-3">
        @foreach (var cs in Model)
        {
            <div class="col">
                <a class="card h-100 text-decoration-none text-body" asp-controller="CaSi" asp-action="Detail" asp-route-id="@cs.MaCaSi">
                    <img src="~/images/casi/@cs.HinhAnh" class="card-img-top ratio ratio-1x1 object-fit-cover" alt="@cs.TenCaSi" />
                    <div class="card-body p-2"><span class="fw-semibold small">@cs.TenCaSi</span></div>
                </a>
            </div>
        }
    </div>
</section>