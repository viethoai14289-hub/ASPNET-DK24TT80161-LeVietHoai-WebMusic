@model IEnumerable<CaSi>
@{
    ViewData["Title"] = "Ca sĩ";
}

<div class="musico-bradcam">
    <div class="container">
        <h1>Ca sĩ</h1>
    </div>
</div>

<div class="container">
    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-3">
        @foreach (var cs in Model)
        {
            <div class="col">
                <a class="musico-gallery-item text-decoration-none" asp-controller="CaSi" asp-action="Detail" asp-route-id="@cs.MaCaSi">
                    <img src="~/images/casi/@cs.HinhAnh" alt="@cs.TenCaSi" style="border-radius:50%" />
                    <div class="musico-gallery-overlay" style="border-radius:50%"><svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0z"/></svg></div>
                    <div class="musico-gallery-caption text-center" style="background:none"><h6>@cs.TenCaSi</h6></div>
                </a>
            </div>
        }
    </div>
</div>