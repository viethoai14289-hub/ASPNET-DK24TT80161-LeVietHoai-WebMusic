@model CaSiDetailVM
@{
    ViewData["Title"] = Model.CaSi?.TenCaSi;
    var cs = Model.CaSi!;
}

<div class="d-flex flex-wrap gap-4 mb-4">
    <img class="rounded" style="width:220px;height:220px;object-fit:cover" src="~/images/casi/@cs.HinhAnh" alt="@cs.TenCaSi" />
    <div class="flex-grow-1" style="min-width:240px">
        <h1 class="h2">@cs.TenCaSi</h1>
        <p class="text-muted mb-1">Năm sinh: @cs.NamSinh</p>
        <p class="text-muted mb-1">Quê quán: @cs.QueQuan</p>
        <p class="mt-2" style="white-space:pre-line">@cs.MoTaThem</p>
    </div>
</div>

<section class="mb-4">
    <h2 class="h4 mb-3 border-start border-success ps-2">Bài hát của @cs.TenCaSi</h2>
    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-3">
        @foreach (var bh in Model.BaiHats)
        {
            <div class="col">
                <a class="card h-100 text-decoration-none text-body" asp-controller="BaiHat" asp-action="Detail" asp-route-id="@bh.MaBaiHat">
                    <img src="~/images/baihat/@bh.HinhAnh" class="card-img-top ratio ratio-1x1 object-fit-cover" alt="@bh.TenBaiHat" />
                    <div class="card-body p-2"><span class="fw-semibold small">@bh.TenBaiHat</span></div>
                </a>
            </div>
        }
    </div>
</section>

<section class="mb-4">
    <h2 class="h4 mb-3 border-start border-success ps-2">Album của @cs.TenCaSi</h2>
    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-3">
        @foreach (var ab in Model.Albums)
        {
            <div class="col">
                <a class="card h-100 text-decoration-none text-body" asp-controller="Album" asp-action="Detail" asp-route-id="@ab.MaAlbum">
                    <img src="~/images/album/@ab.HinhAnh" class="card-img-top ratio ratio-1x1 object-fit-cover" alt="@ab.TenAlbum" />
                    <div class="card-body p-2"><span class="fw-semibold small">@ab.TenAlbum</span></div>
                </a>
            </div>
        }
    </div>
</section>