@model CaSiDetailVM
@{
    ViewData["Title"] = Model.CaSi?.TenCaSi;
    var cs = Model.CaSi!;
}

<div class="detail-view">
    <img class="detail-cover" src="~/images/casi/@cs.HinhAnh" alt="@cs.TenCaSi" />
    <div class="detail-info">
        <h1>@cs.TenCaSi</h1>
        <p class="meta">Năm sinh: @cs.NamSinh</p>
        <p class="meta">Quê quán: @cs.QueQuan</p>
        <p class="desc">@cs.MoTaThem</p>
    </div>
</div>

<section class="section">
    <h2>Bài hát của @cs.TenCaSi</h2>
    <div class="card-grid">
        @foreach (var bh in Model.BaiHats)
        {
            <a class="card" asp-controller="BaiHat" asp-action="Detail" asp-route-id="@bh.MaBaiHat">
                <img src="~/images/baihat/@bh.HinhAnh" alt="@bh.TenBaiHat" />
                <span>@bh.TenBaiHat</span>
            </a>
        }
    </div>
</section>

<section class="section">
    <h2>Album của @cs.TenCaSi</h2>
    <div class="card-grid">
        @foreach (var ab in Model.Albums)
        {
            <a class="card" asp-controller="Album" asp-action="Detail" asp-route-id="@ab.MaAlbum">
                <img src="~/images/album/@ab.HinhAnh" alt="@ab.TenAlbum" />
                <span>@ab.TenAlbum</span>
            </a>
        }
    </div>
</section>