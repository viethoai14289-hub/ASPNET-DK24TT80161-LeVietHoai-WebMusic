@model IEnumerable<BaiHat>
@{
    ViewData["Title"] = "Bài hát";
}

<div class="musico-bradcam">
    <div class="container">
        <h1>Bài hát</h1>
    </div>
</div>

<div class="container">
    <div class="card">
        <div class="card-body">
            @foreach (var bh in Model)
            {
                @await Html.PartialAsync("_TrackRow", bh)
            }
        </div>
    </div>
</div>