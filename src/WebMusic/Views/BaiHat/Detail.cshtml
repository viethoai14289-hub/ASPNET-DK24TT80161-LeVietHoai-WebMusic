@model BaiHat
@{
    ViewData["Title"] = Model.TenBaiHat;
    var related = ViewBag.Related as List<BaiHat> ?? new();
}

<div class="musico-bradcam">
    <div class="container">
        <h1>@Model.TenBaiHat</h1>
    </div>
</div>

<div class="container">
    <div class="musico-about mb-4">
        <div class="about-thumb">
            <img src="~/images/baihat/@Model.HinhAnh" alt="@Model.TenBaiHat" class="wm-cover-lg" style="width:280px;height:280px" />
        </div>
        <div class="about-info">
            <h3>@Model.TenBaiHat</h3>
            <p>Tác giả: @Model.TacGia</p>
            <p><span class="badge" style="background:#1db954;color:#fff">@Model.LuotNghe lượt nghe</span></p>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="YeuThich" asp-action="Toggle" method="post" class="mt-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="maBaiHat" value="@Model.MaBaiHat" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    <button type="submit" class="boxed-btn" style="@(ViewBag.IsLiked is true ? "background:#1db954;color:#fff;border-color:#1db954" : "")">
                        @(ViewBag.IsLiked is true ? "❤️ Đã thích" : "🤍 Yêu thích")
                    </button>
                </form>
            }

            @if (!string.IsNullOrEmpty(Model.LinkBaiHat))
            {
                <div class="mt-3">
                    <button type="button" class="boxed-btn wm-play-overlay-static"
                            style="background:#1db954;color:#fff;border-color:#1db954"
                            data-src="/audio/@Model.LinkBaiHat" data-title="@Model.TenBaiHat"
                            data-cover="/images/baihat/@Model.HinhAnh" data-id="@Model.MaBaiHat">
                        <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M5.5 3.5v9l7-4.5z"/></svg> Phát nhạc
                    </button>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.LoiBaiHat))
            {
                <div class="mt-4">
                    <h4>Lời bài hát</h4>
                    <blockquote class="wm-lyrics">@Model.LoiBaiHat</blockquote>
                </div>
            }
        </div>
    </div>

    @if (related.Any())
    {
        <section class="mb-4">
            <h2 class="musico-section-title">Bài hát liên quan</h2>
            <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-3">
                @foreach (var bh in related)
                {
                    @await Html.PartialAsync("_SongCard", bh)
                }
            </div>
        </section>
    }
</div>