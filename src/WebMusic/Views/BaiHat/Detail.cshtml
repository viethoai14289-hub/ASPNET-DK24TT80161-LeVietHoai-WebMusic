@model BaiHat
@{
    ViewData["Title"] = Model.TenBaiHat;
}

<div class="d-flex flex-wrap gap-4 mb-4">
    <img class="rounded" style="width:220px;height:220px;object-fit:cover" src="~/images/baihat/@Model.HinhAnh" alt="@Model.TenBaiHat" />
    <div class="flex-grow-1" style="min-width:240px">
        <h1 class="h2">@Model.TenBaiHat</h1>
        <p class="text-muted">Tác giả: @Model.TacGia</p>

        @if (!string.IsNullOrEmpty(Model.LinkBaiHat))
        {
            <audio controls preload="auto" class="w-100 mt-2" style="max-width:500px">
                <source src="~/audio/@Model.LinkBaiHat" type="audio/mpeg" />
                Trình duyệt không hỗ trợ phát nhạc.
            </audio>
        }

        <div class="mt-4">
            <h3 class="h5">Lời bài hát</h3>
            <pre class="bg-body-tertiary p-3 rounded" style="white-space:pre-wrap">@Model.LoiBaiHat</pre>
        </div>
    </div>
</div>