@model ErrorViewModel
@{
    ViewData["Title"] = "Lỗi";
}

<div class="alert alert-danger">
    <h1 class="h4 alert-heading">Đã xảy ra lỗi</h1>
    <p class="mb-0">Đã có lỗi xảy ra khi xử lý yêu cầu của bạn.</p>
</div>

@if (Model.ShowRequestId)
{
    <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
}

<h3 class="h5 mt-4">Chế độ Development</h3>
<p>
    Chuyển sang môi trường <strong>Development</strong> sẽ hiển thị thông tin chi tiết hơn về lỗi.
</p>
<p class="text-warning">
    <strong>Không nên bật Development cho ứng dụng đã triển khai</strong> — có thể lộ thông tin nhạy cảm.
    Để debug, đặt <strong>ASPNETCORE_ENVIRONMENT</strong> = <strong>Development</strong> rồi khởi động lại app.
</p>