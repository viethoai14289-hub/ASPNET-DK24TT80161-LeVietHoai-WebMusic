<!DOCTYPE html>
<html lang="vi" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1db954" />
    <title>@ViewData["Title"] - WebMusic</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        :root { --bs-primary: #1db954; --bs-primary-rgb: 29,185,84; }
        .text-primary, .link-primary { color: #1db954 !important; }
        .btn-success { --bs-btn-bg: #1db954; --bs-btn-border-color: #1db954; --bs-btn-hover-bg: #1ed760; --bs-btn-hover-border-color: #1ed760; --bs-btn-active-bg: #1aa84d; --bs-btn-active-border-color: #1aa84d; color: #000; }
        .border-success { border-color: #1db954 !important; }
        .card:hover { transform: translateY(-2px); transition: transform .15s; }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg bg-body-tertiary sticky-top shadow-sm">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <img src="~/images/logo.png" alt="WebMusic" height="36" />
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Mở menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link" asp-controller="BaiHat" asp-action="Index">Bài hát</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="ChuDe" asp-action="Index">Chủ đề</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="TheLoai" asp-action="Index">Thể loại</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="CaSi" asp-action="Index">Ca sĩ</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Playlist" asp-action="Index">Playlist</a></li>
                </ul>
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="text-muted small">Xin chào, @User.Identity.Name</span>
                        <a class="nav-link" asp-controller="Account" asp-action="Logout">Đăng xuất</a>
                    }
                    else
                    {
                        <a class="nav-link" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                        <a class="nav-link" asp-controller="Account" asp-action="Register">Đăng ký</a>
                    }
                    <form class="d-flex" asp-controller="Search" asp-action="Index" method="get" role="search">
                        <input class="form-control me-2" type="search" name="q" placeholder="Tìm bài hát, ca sĩ, album..." aria-label="Tìm kiếm" />
                        <button class="btn btn-success" type="submit">Tìm</button>
                    </form>
                </div>
            </div>
        </div>
    </nav>

    <main class="container-fluid py-4 px-3 px-lg-4 flex-grow-1">
        @RenderBody()
    </main>

    <footer class="bg-body-tertiary border-top mt-auto py-4">
        <div class="container">
            <div class="row g-4">
                <div class="col-12 col-md-4">
                    <h5>Hỗ trợ</h5>
                    <p class="text-muted small">FAQ, hướng dẫn, liên hệ chăm sóc khách hàng.</p>
                </div>
                <div class="col-12 col-md-4">
                    <h5>Sản phẩm khác</h5>
                    <p class="text-muted small">Ứng dụng mobile, WebMusic Plus, WebMusic Premium.</p>
                </div>
                <div class="col-12 col-md-4">
                    <h5>Kết nối</h5>
                    <p class="text-muted small">Facebook &nbsp; Instagram</p>
                </div>
            </div>
            <hr />
            <p class="text-center text-muted small mb-0">WebMusic — dự án học nhóm ASP.NET Core MVC.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>