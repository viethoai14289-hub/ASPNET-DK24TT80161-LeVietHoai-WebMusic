                <div class="search-box">
                    <asp:TextBox runat="server" ID="txtSearch" placeholder="Tìm bài hát, ca sĩ..."></asp:TextBox>
                    <asp:Button runat="server" Text="Tìm" CssClass="button-21" OnClick="Unnamed1_Click" />
